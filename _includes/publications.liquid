{% comment %}
  publications.liquid
  - Usage: {% include publications.liquid publications=site.data.publications %}
  - Falls back to site.data.publications, site.data.papers, or site.data.bibliography
  - Each entry supports: thumbnail, title, citation (or summary), journal, year, url
{% endcomment %}

{% assign pubs = include.publications | default: site.data.publications | default: site.data.papers | default: site.data.bibliography | default: '' %}
{% if pubs == '' %}
  <p>No publications found. Add a data file at _data/publications.yml (or pass publications= to the include).</p>
{% else %}
  <div class="publications-list">
    {% for p in pubs %}
      <div class="d-flex align-items-start mb-4 gap-3">
        <div class="flex-shrink-0" style="width:107px;">
          {% if p.thumbnail %}
            <a href="{{ p.url }}" target="_blank" rel="noopener noreferrer">
              <img src="{{ p.thumbnail | relative_url }}" style="width:107px; height:auto; display:block;" alt="{{ p.title | escape }}">
            </a>
          {% else %}
            <div class="d-flex align-items-center justify-content-center bg-light" style="width:107px; height:151px;">
              <i class="fa-solid fa-file-lines fa-2x text-muted"></i>
            </div>
          {% endif %}
        </div>

        <div class="flex-grow-1">
          {% if p.title %}
            <h5 class="mb-1 font-weight-normal">
              <a href="{{ p.url }}" target="_blank" rel="noopener noreferrer" class="text-decoration-none" style="color: #000;">{% if p.type %}<strong>{{ p.type }}:</strong> {% endif %}{{ p.title }}</a>
            </h5>
          {% endif %}
          {% if p.citation %}
            <p class="mb-1 text-muted">{{ p.citation | markdownify | strip_newlines }}</p>
          {% elsif p.summary %}
            <p class="mb-1 text-muted">{{ p.summary | markdownify | strip_newlines }}</p>
          {% endif %}
          {% if p.journal or p.year %}
            <p class="mb-0 small text-muted">
              {% if p.journal %}<em>{{ p.journal }}</em>{% endif %}
              {% if p.year %}<br>{{ p.year }}{% endif %}
            </p>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
{% endif %}
